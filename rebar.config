{erl_opts, [debug_info]}.

{deps, [
    %% Pinned to match what macula-station runs in production. The
    %% harness uses the same SDK as the relay server side so any
    %% wire-format mismatch surfaces as a real-fleet bug, not a
    %% harness/server version skew. (hecate-daemon currently pins
    %% `~> 4.4.10' — also wire-compatible — so daemon-vs-harness
    %% behaviour should match. Confirmed: the mpong-payload publish
    %% path dies on both 4.4.10 and 4.7.x against the live fleet.)
    %% 8.0.0 (2026-08-13): a handler's own refusal reason reaches the
    %% caller instead of the constant {error,{call_error,15,
    %% unknown_error}} that every refusal in the world used to arrive
    %% as. The duel's `rpc_refusal_reason_survives_hop' round is what
    %% pins it, and on 7.0.0 that round fails with exactly the old
    %% constant. The live fleet is on 7.1.0 and only RELAYS the ERROR
    %% frame, so the contract is between the two SDKs at either end.
    {macula, "~> 9.2"}
]}.

{ct_opts, [
    {logdir, "_build/test/ct_logs"},
    {sys_config, "config/sys.config"}
]}.

{shell, [
    {apps, [macula_e2e]}
]}.

{dialyzer, [
    {plt_apps, all_deps},
    {warnings, [no_return]}
]}.

{profiles, [
    {lint, [
        {plugins, [{rebar3_lint, "5.0.4"}]}
    ]}
]}.

{elvis, [
    {rulesets, #{
        macula_min => [
            {elvis_style, no_deep_nesting, #{level => 2}},
            {elvis_style, no_nested_try_catch, #{}},
            {elvis_style, no_if_expression, #{}}
        ]
    }},
    {config, [ #{files => ["src/**/*.erl"], ruleset => macula_min} ]}
]}.
