{erl_opts, [debug_info]}.

{deps, [
    %% The harness runs the SAME SDK as the side it tests, so a wire-format
    %% mismatch surfaces as a real bug rather than as harness-versus-server
    %% skew. Keep this pin equal to what `macula-station' declares.
    %%
    %% 12.0 (2026-09-23): the post-quantum release. The wire breaks against
    %% every 11.x, so this is not a pin that can drift: an 11 station and a 12
    %% harness cannot connect in either direction (`?VERSION' 3 against 4).
    %% From HEX, not a git dep: the exception that let this repo carry git
    %% dependencies on `macula' ended at the 12 tag.
    {macula, "~> 12.0"},

    {recon, "~> 2.5"}
]}.

{ct_opts, [
    {logdir, "_build/test/ct_logs"},
    {sys_config, "config/sys.config"}
]}.

{shell, [
    {apps, [macula_e2e]}
]}.

{dialyzer, [
    {plt_apps, all_deps},
    {warnings, [no_return]}
]}.

{profiles, [
    %% ⛔ The station SOURCE is private, and this repository and its image are
    %% public. So nothing that reaches the default profile, the lint profile or
    %% the image may pull macula-station: the station apps live ONLY here, for
    %% the seam suite, which runs on a workstation that can read that repo:
    %%
    %%   rebar3 as seam ct --suite seam/realm_seam_SUITE
    %%
    %% The suite sits in `seam/', not `test/', so a plain `rebar3 ct' neither
    %% compiles nor runs it.
    {seam, [
        {deps, [
        %% The station, for `macula_station_harness': spawns real stations on
        %% their own `peer' nodes so the seam suite needs no fleet. Git deps
        %% because macula-station is not on hex, one per app because rebar3
        %% cannot consume an umbrella as a single dependency, and the whole
        %% umbrella rather than the harness alone because the harness puts
        %% `code:get_path()' on the peer and the station's own apps have to be
        %% on it.
        %%
        %% Pinned to an explicit SHA, not a branch: a moving ref buys nothing and
        %% costs reproducibility. Bump it deliberately.
        {macula_station_harness,
         {git_subdir, "https://github.com/macula-io/macula-station.git",
          {ref, "9d40a420dd3f7a83f2f2ba2a33d6ad204fc367b5"}, "apps/macula_station_harness"}},
        {macula_station,
         {git_subdir, "https://github.com/macula-io/macula-station.git",
          {ref, "9d40a420dd3f7a83f2f2ba2a33d6ad204fc367b5"}, "apps/macula_station"}},
        {macula_dht,
         {git_subdir, "https://github.com/macula-io/macula-station.git",
          {ref, "9d40a420dd3f7a83f2f2ba2a33d6ad204fc367b5"}, "apps/macula_dht"}},
        {macula_swim,
         {git_subdir, "https://github.com/macula-io/macula-station.git",
          {ref, "9d40a420dd3f7a83f2f2ba2a33d6ad204fc367b5"}, "apps/macula_swim"}},
        {macula_bootstrap,
         {git_subdir, "https://github.com/macula-io/macula-station.git",
          {ref, "9d40a420dd3f7a83f2f2ba2a33d6ad204fc367b5"}, "apps/macula_bootstrap"}},
        {macula_transport,
         {git_subdir, "https://github.com/macula-io/macula-station.git",
          {ref, "9d40a420dd3f7a83f2f2ba2a33d6ad204fc367b5"}, "apps/macula_transport"}},
        {macula_handler,
         {git_subdir, "https://github.com/macula-io/macula-station.git",
          {ref, "9d40a420dd3f7a83f2f2ba2a33d6ad204fc367b5"}, "apps/macula_handler"}},
        {hecate_realm,
         {git_subdir, "https://github.com/macula-io/macula-station.git",
          {ref, "9d40a420dd3f7a83f2f2ba2a33d6ad204fc367b5"}, "apps/hecate_realm"}}
        ]},
        {extra_src_dirs, [{"seam", [{recursive, false}]}]},
        {ct_opts, [{dir, "seam"}]}
    ]},
    {lint, [
        {plugins, [{rebar3_lint, "5.0.4"}]}
    ]}
]}.

{elvis, [
    {rulesets, #{
        macula_min => [
            {elvis_style, no_deep_nesting, #{level => 2}},
            {elvis_style, no_nested_try_catch, #{}},
            {elvis_style, no_if_expression, #{}}
        ]
    }},
    {config, [ #{files => ["src/**/*.erl"], ruleset => macula_min} ]}
]}.
