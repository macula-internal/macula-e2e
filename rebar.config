{erl_opts, [debug_info]}.

{deps, [
    %% Pinned to match what macula-station runs in production. The
    %% harness uses the same SDK as the relay server side so any
    %% wire-format mismatch surfaces as a real-fleet bug, not a
    %% harness/server version skew. (hecate-daemon currently pins
    %% `~> 4.4.10' — also wire-compatible — so daemon-vs-harness
    %% behaviour should match. Confirmed: the mpong-payload publish
    %% path dies on both 4.4.10 and 4.7.x against the live fleet.)
    %% 8.0.0 (2026-08-13): a handler's own refusal reason reaches the
    %% caller instead of the constant {error,{call_error,15,
    %% unknown_error}} that every refusal in the world used to arrive
    %% as. The duel's `rpc_refusal_reason_survives_hop' round is what
    %% pins it, and on 7.0.0 that round fails with exactly the old
    %% constant. The live fleet is on 7.1.0 and only RELAYS the ERROR
    %% frame, so the contract is between the two SDKs at either end.
    %%
    %% Bumped 9.2 -> 10.5 (2026-08-27): the fleet moved on to the 10.x
    %% line (currently 10.10.0) and this pin had drifted, silently
    %% violating this comment's own stated invariant -- the harness was
    %% no longer running the same SDK as the relay side it tests
    %% against. `~>' so it tracks 10.x without another manual bump.
    %% Bumped 10.5 -> 11.4 (2026-09-21) for the realm-seam suite. 11.x is
    %% where a dial is pinned (D5) and where `macula:advertise/5' resolves a
    %% D25 provider authorization before it will advertise at all, which is
    %% the whole subject of realm_seam_SUITE.
    {macula, "~> 11.4"},

    %% The station, for `macula_station_harness': spawns real stations on
    %% their own `peer' nodes so the seam suite needs no fleet. Git deps
    %% because macula-station is not on hex, one per app because rebar3
    %% cannot consume an umbrella as a single dependency, and the whole
    %% umbrella rather than the harness alone because the harness puts
    %% `code:get_path()' on the peer and the station's own apps have to be
    %% on it.
    %%
    %% Pinned to an explicit SHA, not a branch: this repo publishes nothing,
    %% so a moving ref buys nothing and costs reproducibility. Bump it
    %% deliberately.
    {macula_station_harness,
     {git_subdir, "https://github.com/macula-io/macula-station.git",
      {ref, "1c33572112b9112ea1ae30b6bf06baf4098716e2"}, "apps/macula_station_harness"}},
    {macula_station,
     {git_subdir, "https://github.com/macula-io/macula-station.git",
      {ref, "1c33572112b9112ea1ae30b6bf06baf4098716e2"}, "apps/macula_station"}},
    {macula_dht,
     {git_subdir, "https://github.com/macula-io/macula-station.git",
      {ref, "1c33572112b9112ea1ae30b6bf06baf4098716e2"}, "apps/macula_dht"}},
    {macula_swim,
     {git_subdir, "https://github.com/macula-io/macula-station.git",
      {ref, "1c33572112b9112ea1ae30b6bf06baf4098716e2"}, "apps/macula_swim"}},
    {macula_bootstrap,
     {git_subdir, "https://github.com/macula-io/macula-station.git",
      {ref, "1c33572112b9112ea1ae30b6bf06baf4098716e2"}, "apps/macula_bootstrap"}},
    {macula_transport,
     {git_subdir, "https://github.com/macula-io/macula-station.git",
      {ref, "1c33572112b9112ea1ae30b6bf06baf4098716e2"}, "apps/macula_transport"}},
    {macula_handler,
     {git_subdir, "https://github.com/macula-io/macula-station.git",
      {ref, "1c33572112b9112ea1ae30b6bf06baf4098716e2"}, "apps/macula_handler"}},
    {hecate_realm,
     {git_subdir, "https://github.com/macula-io/macula-station.git",
      {ref, "1c33572112b9112ea1ae30b6bf06baf4098716e2"}, "apps/hecate_realm"}},
    {recon, "~> 2.5"}
]}.

{ct_opts, [
    {logdir, "_build/test/ct_logs"},
    {sys_config, "config/sys.config"}
]}.

{shell, [
    {apps, [macula_e2e]}
]}.

{dialyzer, [
    {plt_apps, all_deps},
    {warnings, [no_return]}
]}.

{profiles, [
    {lint, [
        {plugins, [{rebar3_lint, "5.0.4"}]}
    ]}
]}.

{elvis, [
    {rulesets, #{
        macula_min => [
            {elvis_style, no_deep_nesting, #{level => 2}},
            {elvis_style, no_nested_try_catch, #{}},
            {elvis_style, no_if_expression, #{}}
        ]
    }},
    {config, [ #{files => ["src/**/*.erl"], ruleset => macula_min} ]}
]}.
