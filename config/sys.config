%% -*- mode: erlang -*-
%% `rebar.config''s ct_opts has named this file since the repo began, but it
%% was never tracked, so a fresh clone ran CT with no sys.config at all.
%% Harmless on the 10.x line; on 11.x `macula_app:start/2' refuses to start
%% without exactly one crypto_profile and every case dies in init_per_suite
%% with {crypto_profile_missing, _}.
[
    {macula, [
        %% Must match what the spawned stations run: macula_station_harness
        %% pins pq_hybrid on each peer before starting macula, and a driver
        %% on a different profile cannot complete a handshake with them.
        {crypto_profile, pq_hybrid}

        %% ⛔ `puzzle_difficulty' USED TO BE SET HERE AND MUST NOT BE.
        %% macula 12 REFUSES TO START when it is present, whatever the value:
        %% {bad_config, {macula, puzzle_difficulty, {not_a_setting, 8}}}. The
        %% difficulty is `macula_node_keys:puzzle_difficulty/0', one constant
        %% for the fleet (D30), so a node that set it believed it had chosen
        %% something. Setting it again kills every case in init_per_suite.
    ]}
].
